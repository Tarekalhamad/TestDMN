<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns="https://telenor.se/promotion-compatibility" xmlns:kie="http://www.drools.org/kie/dmn/1.5" xmlns:feel="https://www.omg.org/spec/DMN/20191111/FEEL/" id="_PROMOTION_COMPATIBILITY" name="PromotionCompatibility" namespace="https://telenor.se/promotion-compatibility" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/" typeLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/">
  <dmn:extensionElements />

  <!-- ============================================================
       Item model. One item type covers promotions and add-on offerings,
       so every rule works on both without a parallel rule set.
       ============================================================ -->
  <dmn:itemDefinition id="_tItem" name="tItem" isCollection="false">
    <dmn:itemComponent id="_tItem_itemId" name="itemId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tItem_itemName" name="itemName" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tItem_itemType" name="itemType" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tItem_category" name="discountCategory" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tItem_origin" name="origin" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tItem_scopeId" name="scopeId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tItem_serviceType" name="serviceType" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_tItemList" name="tItemList" isCollection="true">
    <dmn:typeRef>tItem</dmn:typeRef>
  </dmn:itemDefinition>

  <!-- ============================================================
       Rule table row types. One type per table.
       ============================================================ -->
  <dmn:itemDefinition id="_tPrecedenceRow" name="tPrecedenceRow" isCollection="false">
    <dmn:itemComponent id="_tPrecedenceRow_cat" name="discountCategory" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tPrecedenceRow_rank" name="precedenceRank" isCollection="false">
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_tPrecedenceRowList" name="tPrecedenceRowList" isCollection="true">
    <dmn:typeRef>tPrecedenceRow</dmn:typeRef>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_tCategoryRule" name="tCategoryRule" isCollection="false">
    <dmn:itemComponent id="_tCategoryRule_ruleId" name="ruleId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tCategoryRule_a" name="categoryA" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tCategoryRule_b" name="categoryB" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tCategoryRule_winner" name="winner" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tCategoryRule_svc" name="serviceType" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tCategoryRule_ch" name="channel" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tCategoryRule_desc" name="description" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_tCategoryRuleList" name="tCategoryRuleList" isCollection="true">
    <dmn:typeRef>tCategoryRule</dmn:typeRef>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_tItemRule" name="tItemRule" isCollection="false">
    <dmn:itemComponent id="_tItemRule_ruleId" name="ruleId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tItemRule_item" name="itemId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tItemRule_withItem" name="conflictsWithItemId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tItemRule_withCat" name="conflictsWithCategory" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tItemRule_winner" name="winner" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tItemRule_svc" name="serviceType" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tItemRule_ch" name="channel" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tItemRule_desc" name="description" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_tItemRuleList" name="tItemRuleList" isCollection="true">
    <dmn:typeRef>tItemRule</dmn:typeRef>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_tCardinalityRule" name="tCardinalityRule" isCollection="false">
    <dmn:itemComponent id="_tCardinalityRule_ruleId" name="ruleId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tCardinalityRule_cat" name="discountCategory" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tCardinalityRule_max" name="maxAllowed" isCollection="false">
      <dmn:typeRef>number</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tCardinalityRule_svc" name="serviceType" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tCardinalityRule_ch" name="channel" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tCardinalityRule_desc" name="description" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_tCardinalityRuleList" name="tCardinalityRuleList" isCollection="true">
    <dmn:typeRef>tCardinalityRule</dmn:typeRef>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_tExceptionRule" name="tExceptionRule" isCollection="false">
    <dmn:itemComponent id="_tExceptionRule_ruleId" name="ruleId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tExceptionRule_item" name="exemptItemId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tExceptionRule_rule" name="appliesToRuleId" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tExceptionRule_whenCat" name="whenCategoryPresent" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tExceptionRule_whenItem" name="whenItemPresent" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
    <dmn:itemComponent id="_tExceptionRule_desc" name="description" isCollection="false">
      <dmn:typeRef>string</dmn:typeRef>
    </dmn:itemComponent>
  </dmn:itemDefinition>
  <dmn:itemDefinition id="_tExceptionRuleList" name="tExceptionRuleList" isCollection="true">
    <dmn:typeRef>tExceptionRule</dmn:typeRef>
  </dmn:itemDefinition>

  <!-- ============================================================
       Inputs. Channel is request-level; everything else is per item.
       ============================================================ -->
  <dmn:inputData id="_IN_ITEMS" name="Items">
    <dmn:extensionElements />
    <dmn:variable id="_V_IN_ITEMS" name="Items" typeRef="tItemList" />
  </dmn:inputData>
  <dmn:inputData id="_IN_CHANNEL" name="Channel">
    <dmn:extensionElements />
    <dmn:variable id="_V_IN_CHANNEL" name="Channel" typeRef="string" />
  </dmn:inputData>

  <!-- ============================================================
       DATA TABLES - business-editable. Five grids, one per rule shape.
       Every rule carries a ruleId so a verdict can point at it.
       An empty winner cell means "decide by precedence rank" in every table.
       ============================================================ -->
  <!-- CategoryPrecedence: rank per discount category. Lower rank wins. A category missing from this table ranks 999 and therefore loses every precedence contest. -->
  <dmn:decision id="_D_PRECEDENCE" name="CategoryPrecedence">
    <dmn:extensionElements />
    <dmn:variable id="_V_PRECEDENCE" name="CategoryPrecedence" typeRef="tPrecedenceRowList" />
    <dmn:decisionTable id="_DT_PRECEDENCE" hitPolicy="COLLECT" preferredOrientation="Rule-as-Row" outputLabel="CategoryPrecedence">
      <dmn:input id="_DT_PRECEDENCE_IN1">
        <dmn:inputExpression id="_DT_PRECEDENCE_IE1" typeRef="string">
          <dmn:text>"match"</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:output id="_DT_PRECEDENCE_OUT1" name="discountCategory" typeRef="string" />
      <dmn:output id="_DT_PRECEDENCE_OUT2" name="precedenceRank" typeRef="number" />
      <dmn:annotation name="note" />
      <dmn:rule id="_DT_PRECEDENCE_R1">
        <dmn:inputEntry id="_DT_PRECEDENCE_R1_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R1_O1">
          <dmn:text>"EmployeeDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R1_O2">
          <dmn:text>1</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R2">
        <dmn:inputEntry id="_DT_PRECEDENCE_R2_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R2_O1">
          <dmn:text>"ComplaintDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R2_O2">
          <dmn:text>2</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R3">
        <dmn:inputEntry id="_DT_PRECEDENCE_R3_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R3_O1">
          <dmn:text>"SaveDeskDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R3_O2">
          <dmn:text>3</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R4">
        <dmn:inputEntry id="_DT_PRECEDENCE_R4_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R4_O1">
          <dmn:text>"ChurnBlockerDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R4_O2">
          <dmn:text>4</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R5">
        <dmn:inputEntry id="_DT_PRECEDENCE_R5_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R5_O1">
          <dmn:text>"SignUpDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R5_O2">
          <dmn:text>5</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R6">
        <dmn:inputEntry id="_DT_PRECEDENCE_R6_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R6_O1">
          <dmn:text>"SignUpDiscountLimited"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R6_O2">
          <dmn:text>6</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R7">
        <dmn:inputEntry id="_DT_PRECEDENCE_R7_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R7_O1">
          <dmn:text>"LegacyBindingDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R7_O2">
          <dmn:text>7</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R8">
        <dmn:inputEntry id="_DT_PRECEDENCE_R8_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R8_O1">
          <dmn:text>"OTSDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R8_O2">
          <dmn:text>8</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R9">
        <dmn:inputEntry id="_DT_PRECEDENCE_R9_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R9_O1">
          <dmn:text>"HWSubscriptionDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R9_O2">
          <dmn:text>9</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R10">
        <dmn:inputEntry id="_DT_PRECEDENCE_R10_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R10_O1">
          <dmn:text>"HWSubscriptionDiscountLimited"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R10_O2">
          <dmn:text>10</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R11">
        <dmn:inputEntry id="_DT_PRECEDENCE_R11_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R11_O1">
          <dmn:text>"HWSubscriptionDiscountAccessory"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R11_O2">
          <dmn:text>11</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R12">
        <dmn:inputEntry id="_DT_PRECEDENCE_R12_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R12_O1">
          <dmn:text>"HWDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R12_O2">
          <dmn:text>12</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R13">
        <dmn:inputEntry id="_DT_PRECEDENCE_R13_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R13_O1">
          <dmn:text>"GeoDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R13_O2">
          <dmn:text>13</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R14">
        <dmn:inputEntry id="_DT_PRECEDENCE_R14_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R14_O1">
          <dmn:text>"KomboDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R14_O2">
          <dmn:text>14</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_PRECEDENCE_R15">
        <dmn:inputEntry id="_DT_PRECEDENCE_R15_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_PRECEDENCE_R15_O1">
          <dmn:text>"PromotionOffering"</dmn:text>
