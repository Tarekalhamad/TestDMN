          <dmn:text>"MiscMigratedDiscountLimited"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R4_O4">
          <dmn:text></dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R4_O5">
          <dmn:text>"Broadband"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R4_O6">
          <dmn:text></dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R4_O7">
          <dmn:text>"The two migrated discount families are mutually exclusive on broadband. Precedence decides."</dmn:text>
