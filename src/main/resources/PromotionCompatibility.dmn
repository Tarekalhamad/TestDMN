          <dmn:text>"ONLINE"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R3_O7">
          <dmn:text>"Hardware and geo discounts cannot be combined when sold online. Precedence decides."</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_CATRULES_R4">
        <dmn:inputEntry id="_DT_CATRULES_R4_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R4_O1">
          <dmn:text>"CAT-004"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R4_O2">
          <dmn:text>"MiscMigratedDiscount"</dmn:text>
        </dmn:outputEntry>
