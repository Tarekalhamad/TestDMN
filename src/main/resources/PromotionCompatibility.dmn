        </dmn:annotationEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
  <!-- CategoryIncompatibility: two discount categories cannot sit on the same contract. winner is A, B or empty (empty = decide by precedence). Blank serviceType or channel means the rule is global. -->
  <dmn:decision id="_D_CATRULES" name="CategoryIncompatibility">
    <dmn:extensionElements />
    <dmn:variable id="_V_CATRULES" name="CategoryIncompatibility" typeRef="tCategoryRuleList" />
    <dmn:decisionTable id="_DT_CATRULES" hitPolicy="COLLECT" preferredOrientation="Rule-as-Row" outputLabel="CategoryIncompatibility">
      <dmn:input id="_DT_CATRULES_IN1">
        <dmn:inputExpression id="_DT_CATRULES_IE1" typeRef="string">
          <dmn:text>"match"</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:output id="_DT_CATRULES_OUT1" name="ruleId" typeRef="string" />
      <dmn:output id="_DT_CATRULES_OUT2" name="categoryA" typeRef="string" />
      <dmn:output id="_DT_CATRULES_OUT3" name="categoryB" typeRef="string" />
      <dmn:output id="_DT_CATRULES_OUT4" name="winner" typeRef="string" />
      <dmn:output id="_DT_CATRULES_OUT5" name="serviceType" typeRef="string" />
      <dmn:output id="_DT_CATRULES_OUT6" name="channel" typeRef="string" />
      <dmn:output id="_DT_CATRULES_OUT7" name="description" typeRef="string" />
      <dmn:annotation name="note" />
      <dmn:rule id="_DT_CATRULES_R1">
        <dmn:inputEntry id="_DT_CATRULES_R1_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R1_O1">
          <dmn:text>"CAT-001"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R1_O2">
          <dmn:text>"EmployeeDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R1_O3">
          <dmn:text>"LegacyBindingDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R1_O4">
          <dmn:text></dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R1_O5">
          <dmn:text></dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R1_O6">
          <dmn:text></dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R1_O7">
          <dmn:text>"An employee discount and a legacy binding discount cannot sit on the same contract. Precedence decides."</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_CATRULES_R2">
        <dmn:inputEntry id="_DT_CATRULES_R2_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R2_O1">
          <dmn:text>"CAT-002"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R2_O2">
          <dmn:text>"SaveDeskDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R2_O3">
          <dmn:text>"ChurnBlockerDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R2_O4">
          <dmn:text>"B"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R2_O5">
          <dmn:text></dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R2_O6">
          <dmn:text></dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R2_O7">
          <dmn:text>"A churn blocker always wins over a save desk discount, even though it ranks lower."</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text></dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="_DT_CATRULES_R3">
        <dmn:inputEntry id="_DT_CATRULES_R3_I1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R3_O1">
          <dmn:text>"CAT-003"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R3_O2">
          <dmn:text>"HWDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R3_O3">
          <dmn:text>"GeoDiscount"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R3_O4">
          <dmn:text></dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="_DT_CATRULES_R3_O5">
          <dmn:text></dmn:text>
        </dmn:outputEntry>
